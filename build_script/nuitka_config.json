{
  "common": {
    "include_packages": [
      "ankidraft",
      "playhouse",
      "peewee_migrate",
      "unittest",
      "zoneinfo",
      "websockets",
      "mcp",
      "starlette",
      "uvicorn",
      "anyio",
      "sniffio",
      "urllib",
      "xml",
      "edge_tts",
      "aiohttp",
      "certifi"
    ],
    "include_package_data": [
      "zoneinfo",
      "certifi"
    ],
    "include_data_files": {},
    "nofollow_imports": [
      "anki",
      "aqt",
      "google",
      "faiss",
      "openai",
      "pydantic",
      "pydantic_core",
      "numpy",
      "requests",
      "jwt",
      "yaml",
      "PIL",
      "lxml",
      "zstandard",
      "jiter",
      "tiktoken",
      "regex",
      "rpds",
      "charset_normalizer",
      "tomli",
      "babel",
      "dateparser",
      "trafilatura",
      "docx",
      "pptx",
      "pypdf",
      "jinja2",
      "bs4",
      "urllib3",
      "httpx",
      "httpcore",
      "jsonschema",
      "cryptography",
      "pymupdf",
      "fitz",
      "youtube_transcript_api",
      "defusedxml",
      "markdownify",
      "markdown",
      "genanki",
      "keyring",
      "dotenv",
      "packaging",
      "tkinter",
      "matplotlib",
      "docutils"
    ],
    "plugins": [
      "pyside6"
    ],
    "no_deployment_flags": [
      "excluded-module-usage"
    ],
    "standard_flags": [
      "--standalone",
      "--low-memory",
      "--lto=no",
      "--assume-yes-for-downloads"
    ]
  },
  "platforms": {
    "darwin": {
      "app_name": "AnkiDraft",
      "output_dir": "dist_prod",
      "output_filename": "AnkiDraft",
      "icon": "src/ressources/icons/ankidraft.icns",
      "extra_flags": [
        "--macos-create-app-bundle"
      ]
    },
    "linux": {
      "output_dir": "dist_prod",
      "output_filename": "AnkiDraft",
      "icon": "src/ressources/icons/ankidraft.png",
      "extra_flags": []
    },
    "windows": {
      "output_dir": "dist_prod",
      "output_filename": "AnkiDraft.exe",
      "icon": "src\\ressources\\icons\\ankidraft.ico",
      "extra_flags": [
        "--windows-console-mode=disable",
        "--msvc=latest"
      ]
    }
  }
}
