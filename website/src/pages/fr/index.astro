---
import { getLatestRelease } from '../../lib/release';

const release = await getLatestRelease();
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AnkiDraft — Transformez vos cours en cartes mémoire Anki</title>
    <meta
      name="description"
      content="Déposez vos cours PDF, vidéos YouTube et notes. AnkiDraft en extrait des flashcards claires, prêtes à être révisées dans Anki sur votre ordinateur et votre téléphone."
    />
    <meta
      name="google-site-verification"
      content="aoyROBDMk0qbvP7PuiHXrvPdCRpsJeLWc904iaDzvBc"
    />
    <link rel="icon" type="image/svg+xml" href="/assets/icons/ankidraft.svg" />
    <link rel="canonical" href="https://ankidraft.app/fr/" />
    <link rel="alternate" hreflang="fr" href="https://ankidraft.app/fr/" />
    <link rel="alternate" hreflang="en" href="https://ankidraft.app/en/" />
    <link rel="alternate" hreflang="x-default" href="https://ankidraft.app/en/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;900&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --paper: #f6f5f0;
        --surface: #ffffff;
        --surface-alt: #efede6;
        --ink: #0f1117;
        --muted: #525663;
        --accent: #3730a3;
        --accent-bright: #4f46e5;
        --display: 'Archivo', -apple-system, BlinkMacSystemFont, sans-serif;
        --sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--paper);
        color: var(--ink);
        font-family: var(--sans);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      .swiss-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      header {
        padding: 1.75rem 0 1.25rem;
        border-bottom: 4px solid var(--ink);
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        align-items: end;
      }
      @media (max-width: 760px) {
        header {
          grid-template-columns: 1fr;
          gap: 1rem;
        }
      }

      .brand {
        font-family: var(--display);
        font-weight: 900;
        font-size: 1.65rem;
        letter-spacing: -0.04em;
        color: var(--ink);
        text-decoration: none;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
      }
      .brand img {
        width: 28px;
        height: 28px;
      }

      .header-meta {
        font-size: 0.82rem;
        color: var(--muted);
        line-height: 1.35;
      }

      nav {
        text-align: right;
      }
      nav a {
        color: var(--ink);
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
        margin-left: 1.5rem;
      }
      nav a:hover {
        color: var(--accent-bright);
      }

      /* Swiss Poster Hero (Variante A) */
      .hero {
        padding: 4.5rem 0 4rem;
        border-bottom: 2px solid var(--ink);
        display: grid;
        grid-template-columns: 8fr 4fr;
        gap: 3rem;
        align-items: end;
      }
      @media (max-width: 900px) {
        .hero {
          grid-template-columns: 1fr;
        }
      }

      h1 {
        font-family: var(--display);
        font-weight: 900;
        font-size: clamp(3rem, 6.4vw, 5.5rem);
        line-height: 0.94;
        letter-spacing: -0.045em;
        margin: 0;
        text-transform: uppercase;
      }
      h1 span {
        color: var(--accent-bright);
        display: block;
      }

      .hero-aside {
        border-left: 2px solid var(--ink);
        padding-left: 2rem;
      }
      @media (max-width: 900px) {
        .hero-aside {
          border-left: none;
          border-top: 2px solid var(--ink);
          padding-left: 0;
          padding-top: 2rem;
        }
      }
      .hero-aside p {
        font-size: 1.1rem;
        margin: 0 0 2rem;
        color: var(--ink);
        font-weight: 500;
      }

      .btn-swiss {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        background: var(--accent);
        color: #ffffff;
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.02rem;
        padding: 1.1rem 1.4rem;
        text-decoration: none;
        transition: background 0.15s;
      }
      .btn-swiss:hover {
        background: var(--ink);
      }

      .os-strip {
        margin-top: 0.85rem;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-size: 0.82rem;
        color: var(--muted);
        border-top: 1px solid var(--ink);
        padding-top: 0.65rem;
      }
      .os-strip a {
        color: var(--ink);
        font-weight: 600;
        text-decoration: none;
      }
      .os-strip a:hover {
        color: var(--accent-bright);
        text-decoration: underline;
      }

      /* Numbered Index Rows (01 / 02 / 03) */
      .index-row {
        display: grid;
        grid-template-columns: 2fr 5fr 5fr;
        gap: 2rem;
        padding: 3rem 0;
        border-bottom: 1px solid var(--ink);
        align-items: start;
      }
      @media (max-width: 860px) {
        .index-row {
          grid-template-columns: 1fr;
          gap: 1rem;
        }
      }

      .index-num {
        font-family: var(--display);
        font-weight: 900;
        font-size: 3.5rem;
        line-height: 0.85;
        letter-spacing: -0.04em;
        color: var(--accent-bright);
      }

      .index-title {
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.85rem;
        line-height: 1.1;
        margin: 0;
        letter-spacing: -0.025em;
      }

      .index-body {
        font-size: 1.02rem;
        color: var(--muted);
        margin: 0;
      }
      .index-body strong {
        color: var(--ink);
      }

      /* Study Transformation Specimen */
      .specimen-section {
        padding: 4rem 0;
        border-bottom: 4px solid var(--ink);
        display: grid;
        grid-template-columns: 4fr 8fr;
        gap: 3rem;
      }
      @media (max-width: 860px) {
        .specimen-section {
          grid-template-columns: 1fr;
        }
      }

      .specimen-label {
        font-family: var(--display);
        font-weight: 900;
        font-size: 1.5rem;
        text-transform: uppercase;
        margin: 0 0 0.75rem;
      }

      .specimen-pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border: 2px solid var(--ink);
        background: var(--surface);
      }
      @media (max-width: 700px) {
        .specimen-pair {
          grid-template-columns: 1fr;
        }
      }
      .spec-col {
        padding: 2rem;
      }
      .spec-col:first-child {
        border-right: 2px solid var(--ink);
        background: var(--surface-alt);
      }
      @media (max-width: 700px) {
        .spec-col:first-child {
          border-right: none;
          border-bottom: 2px solid var(--ink);
        }
      }
      .spec-tag {
        font-family: var(--display);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--muted);
        margin-bottom: 1rem;
        display: block;
      }
      .spec-col.highlight .spec-tag {
        color: var(--accent-bright);
      }

      /* Download Table */
      .dl-section {
        padding: 4rem 0;
        border-bottom: 2px solid var(--ink);
      }
      .dl-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 2rem;
      }
      .dl-table tr {
        border-top: 1px solid var(--ink);
      }
      .dl-table tr:last-child {
        border-bottom: 1px solid var(--ink);
      }
      .dl-table td {
        padding: 1.35rem 0;
        font-size: 1.05rem;
      }
      .dl-table td.os-name {
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.3rem;
      }
      .dl-table td.dl-link {
        text-align: right;
      }
      .dl-table td.dl-link a {
        color: var(--accent-bright);
        font-weight: 700;
        text-decoration: none;
      }
      .dl-table td.dl-link a:hover {
        text-decoration: underline;
      }

      footer {
        padding: 2.5rem 0 4rem;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        font-size: 0.88rem;
        color: var(--muted);
      }
      footer a {
        color: var(--ink);
        text-decoration: none;
        font-weight: 600;
      }
      footer a:hover {
        color: var(--accent-bright);
      }
    </style>
  </head>
  <body>
    <div class="swiss-container">
      <header>
        <a class="brand" href="/fr/">
          <img src="/assets/icons/ankidraft.svg" alt="AnkiDraft" />
          <span>ANKIDRAFT</span>
        </a>
        <div class="header-meta">
          Préparation de cartes Anki à partir de vos cours<br />
          Édition {release.version} — macOS, Windows, Linux
        </div>
        <nav>
          <a href="/fr/getting-started/quickstart/">Guides</a>
          <a href="#telecharger">Télécharger</a>
          <a href="/fr/guides/faq_depannage/">FAQ</a>
          <a href="/en/" hreflang="en">EN</a>
        </nav>
      </header>

      <main>
        <section class="hero">
          <h1>
            Passez vos heures à apprendre,
            <span>pas à copier-coller.</span>
          </h1>
          <div class="hero-aside">
            <p>
              Déposez vos cours PDF, vos vidéos ou vos notes. AnkiDraft en extrait des flashcards claires, prêtes à être révisées dans Anki sur votre ordinateur et votre téléphone.
            </p>
            <a id="primary-dl" class="btn-swiss" href={release.macos.url}>
              <span id="primary-dl-label">Télécharger AnkiDraft v{release.version}</span>
              <span>↓</span>
            </a>
            <div class="os-strip">
              <a href={release.macos.url}>macOS (.dmg)</a>
              <a href={release.windows.url}>Windows (.exe)</a>
              <a href={release.linux.url}>Linux (.AppImage)</a>
              <a href="/fr/getting-started/quickstart/">Manuel →</a>
            </div>
          </div>
        </section>

        <section aria-label="Fonctionnement en trois étapes">
          <div class="index-row">
            <div class="index-num">01</div>
            <h2 class="index-title">Déposez votre cours tel qu'il est</h2>
            <p class="index-body">
              Polycopié PDF de 300 pages, diaporama d'amphi, enregistrement audio ou vidéo YouTube : <strong>aucune remise en forme préalable n'est nécessaire</strong>. Choisissez simplement les chapitres qui tombent à votre prochain examen.
            </p>
          </div>

          <div class="index-row">
            <div class="index-num">02</div>
            <h2 class="index-title">Obtenez des questions courtes et précises</h2>
            <p class="index-body">
              Fini les cartes interminables que l'on finit par réciter par cœur sans les comprendre. Chaque idée importante de votre cours devient <strong>une question simple, une réponse directe</strong>, une formule mathématique propre ou un texte à trous.
            </p>
          </div>

          <div class="index-row">
            <div class="index-num">03</div>
            <h2 class="index-title">Révisez partout dans Anki, sans rien perdre</h2>
            <p class="index-body">
              Exportez votre paquet en un clic vers Anki. Si vous modifiez vos cartes plus tard après avoir déjà révisé dans les transports, <strong>votre progression et vos statistiques de révision restent intactes</strong>.
            </p>
          </div>
        </section>

        <section class="specimen-section">
          <div>
            <h2 class="specimen-label">Ce que vous donnez.<br />Ce que vous retenez.</h2>
            <p style="color: var(--muted); margin: 0;">
              Un paragraphe dense de votre polycopié se transforme immédiatement en questions ciblées, faciles à réviser en quelques secondes chaque matin.
            </p>
          </div>

          <div class="specimen-pair">
            <div class="spec-col">
              <span class="spec-tag">Extrait de votre cours PDF</span>
              <p style="margin: 0; font-size: 0.98rem;">
                « Au cours d'un effort physique intense, le débit cardiaque peut passer de 5 L/min au repos jusqu'à 25 L/min chez le sujet entraîné, principalement grâce à l'augmentation de la fréquence cardiaque et du volume d'éjection systolique. »
              </p>
            </div>
            <div class="spec-col highlight">
              <span class="spec-tag">Carte prête dans votre paquet Anki</span>
              <p style="margin: 0 0 0.75rem; font-weight: 700; font-size: 1.05rem;">
                Quelle est la valeur du débit cardiaque au repos, et jusqu'où peut-il monter à l'effort intense ?
              </p>
              <p style="margin: 0; color: var(--muted);">
                <strong>5 L/min</strong> au repos → jusqu'à <strong>25 L/min</strong> à l'effort.
              </p>
            </div>
          </div>
        </section>

        <section id="telecharger" class="dl-section">
          <h2 class="index-title">Téléchargement gratuit · Fonctionne hors connexion</h2>
          <table class="dl-table">
            <tbody>
              <tr>
                <td class="os-name">macOS</td>
                <td style="color: var(--muted);">macOS 13 ou supérieur (Apple Silicon) · Image disque .dmg</td>
                <td class="dl-link"><a href={release.macos.url}>Télécharger v{release.version} →</a></td>
              </tr>
              <tr>
                <td class="os-name">Windows</td>
                <td style="color: var(--muted);">Windows 10 &amp; 11 (64-bit) · Installateur autonome .exe</td>
                <td class="dl-link"><a href={release.windows.url}>Télécharger v{release.version} →</a></td>
              </tr>
              <tr>
                <td class="os-name">Linux</td>
                <td style="color: var(--muted);">Distribution x86_64 · Exécutable portable .AppImage</td>
                <td class="dl-link"><a href={release.linux.url}>Télécharger v{release.version} →</a></td>
              </tr>
            </tbody>
          </table>
        </section>
      </main>

      <footer>
        <span>© 2026 AnkiDraft — Vos cours et vos cartes restent sur votre ordinateur.</span>
        <span>
          <a href="/fr/getting-started/installation/">Guide d'installation</a> ·
          <a href="/fr/getting-started/quickstart/">Premiers pas</a> ·
          <a href="/fr/guides/raccourcis_clavier/">Raccourcis</a> ·
          <a href="https://github.com/Skyl9/AnkiDraft">GitHub</a>
        </span>
      </footer>
    </div>

    <script is:inline define:vars={{ macosUrl: release.macos.url, windowsUrl: release.windows.url, linuxUrl: release.linux.url, version: release.version }}>
      (function () {
        var ua = navigator.userAgent || '';
        var btn = document.getElementById('primary-dl');
        var lbl = document.getElementById('primary-dl-label');
        if (!btn || !lbl) return;
        if (/Win/i.test(ua)) {
          btn.href = windowsUrl;
          lbl.textContent = 'Télécharger pour Windows (v' + version + ')';
        } else if (/Linux/i.test(ua) && !/Android/i.test(ua)) {
          btn.href = linuxUrl;
          lbl.textContent = 'Télécharger pour Linux (v' + version + ')';
        } else {
          btn.href = macosUrl;
          lbl.textContent = 'Télécharger pour macOS (v' + version + ')';
        }
      })();
    </script>
  </body>
</html>
