<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AnkiDraft — AI-Assisted Flashcard Creation Studio for Anki</title>
    <meta
      name="description"
      content="AnkiDraft — Turn PDFs, videos, and courses into atomic, high-retention Anki flashcards with local-first AI and quality auditing."
    />
    <meta
      name="google-site-verification"
      content="aoyROBDMk0qbvP7PuiHXrvPdCRpsJeLWc904iaDzvBc"
    />
    <link rel="canonical" href="https://ankidraft.app/en/" />
    <link rel="alternate" hreflang="fr" href="https://ankidraft.app/fr/" />
    <link rel="alternate" hreflang="en" href="https://ankidraft.app/en/" />
    <link rel="alternate" hreflang="x-default" href="https://ankidraft.app/en/" />
    <script is:inline>
      (function () {
        try {
          var langs = navigator.languages || [navigator.language || 'en'];
          var target = '/en/';
          for (var i = 0; i < langs.length; i++) {
            var code = String(langs[i] || '').toLowerCase();
            if (code.indexOf('fr') === 0) {
              target = '/fr/';
              break;
            }
            if (code.indexOf('en') === 0) {
              target = '/en/';
              break;
            }
          }
          window.location.replace(target);
        } catch (e) {
          window.location.replace('/en/');
        }
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/en/" />
    </noscript>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #0b0f19;
        color: #f8fafc;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      }
      .card {
        text-align: center;
        padding: 2rem;
      }
      .links a {
        color: #60a5fa;
        margin: 0 0.75rem;
        text-decoration: none;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>AnkiDraft</h1>
      <p>Redirecting to your language / Redirection vers votre langue…</p>
      <p class="links">
        <a href="/fr/">Français</a>
        <a href="/en/">English</a>
      </p>
    </div>
  </body>
</html>
