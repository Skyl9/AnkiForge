---
import { getLatestRelease } from '../../lib/release';

const release = await getLatestRelease();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AnkiDraft — AI-Assisted Flashcard Creation &amp; Quality Studio for Anki</title>
    <meta
      name="description"
      content="Turn PDFs, YouTube lectures, and web articles into atomic, high-retention Anki flashcards. Local-first desktop studio with KaTeX, TTS, and Wozniak quality checks."
    />
    <meta
      name="google-site-verification"
      content="aoyROBDMk0qbvP7PuiHXrvPdCRpsJeLWc904iaDzvBc"
    />
    <link rel="canonical" href="https://ankidraft.app/en/" />
    <link rel="alternate" hreflang="fr" href="https://ankidraft.app/fr/" />
    <link rel="alternate" hreflang="en" href="https://ankidraft.app/en/" />
    <link rel="alternate" hreflang="x-default" href="https://ankidraft.app/en/" />
    <style>
      :root {
        --bg: #0b0f19;
        --bg-card: #131c31;
        --border: #1e293b;
        --text: #f8fafc;
        --muted: #94a3b8;
        --accent: #3b82f6;
        --accent-hover: #2563eb;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: radial-gradient(circle at top, #172554 0%, var(--bg) 55%);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        line-height: 1.6;
      }
      header {
        max-width: 1120px;
        margin: 0 auto;
        padding: 1.25rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .brand {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--text);
        text-decoration: none;
        letter-spacing: -0.02em;
      }
      nav a {
        color: var(--muted);
        text-decoration: none;
        margin-left: 1.5rem;
        font-size: 0.95rem;
      }
      nav a:hover {
        color: var(--text);
      }
      .hero {
        max-width: 960px;
        margin: 3.5rem auto 2.5rem;
        padding: 0 1.5rem;
        text-align: center;
      }
      .badge {
        display: inline-block;
        padding: 0.25rem 0.85rem;
        border-radius: 999px;
        background: rgba(59, 130, 246, 0.15);
        border: 1px solid rgba(59, 130, 246, 0.4);
        color: #93c5fd;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 1.25rem;
      }
      h1 {
        font-size: clamp(2.2rem, 5vw, 3.6rem);
        line-height: 1.12;
        margin: 0 0 1.25rem;
        letter-spacing: -0.03em;
      }
      .subtitle {
        font-size: 1.15rem;
        color: var(--muted);
        max-width: 680px;
        margin: 0 auto 2.25rem;
      }
      .cta-group {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        margin-bottom: 1rem;
      }
      .btn-primary {
        background: var(--accent);
        color: #fff;
        padding: 0.85rem 1.6rem;
        border-radius: 0.6rem;
        font-weight: 700;
        text-decoration: none;
        transition: background 0.15s;
      }
      .btn-primary:hover {
        background: var(--accent-hover);
      }
      .btn-secondary {
        background: var(--bg-card);
        color: var(--text);
        border: 1px solid var(--border);
        padding: 0.85rem 1.5rem;
        border-radius: 0.6rem;
        font-weight: 600;
        text-decoration: none;
      }
      .os-links {
        font-size: 0.9rem;
        color: var(--muted);
        margin-top: 0.75rem;
      }
      .os-links a {
        color: #93c5fd;
        text-decoration: none;
        margin: 0 0.4rem;
      }
      .grid {
        max-width: 1120px;
        margin: 3.5rem auto;
        padding: 0 1.5rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.25rem;
      }
      .card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 0.85rem;
        padding: 1.5rem;
      }
      .card h2 {
        font-size: 1.15rem;
        margin: 0 0 0.5rem;
      }
      .card p {
        color: var(--muted);
        margin: 0;
        font-size: 0.95rem;
      }
      .downloads {
        max-width: 960px;
        margin: 4rem auto;
        padding: 2rem 1.5rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 1rem;
      }
      .downloads h2 {
        margin-top: 0;
        text-align: center;
      }
      .dl-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
      }
      .dl-box {
        padding: 1.25rem;
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        background: rgba(11, 15, 25, 0.5);
      }
      .dl-box h3 {
        margin: 0 0 0.4rem;
      }
      .dl-box a {
        display: inline-block;
        margin-top: 0.75rem;
        color: #60a5fa;
        font-weight: 600;
        text-decoration: none;
      }
      footer {
        max-width: 1120px;
        margin: 4rem auto 2rem;
        padding: 1.5rem;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.88rem;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
      }
      footer a {
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="/en/">AnkiDraft</a>
      <nav>
        <a href="/en/getting-started/quickstart/">User Guides</a>
        <a href="#download">Download</a>
        <a href="/en/guides/raccourcis_clavier/">Shortcuts</a>
        <a href="/en/guides/faq_depannage/">FAQ</a>
        <a href="/fr/" hreflang="fr">Français</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <span class="badge">Version {release.version} Available · 100% Local-First</span>
        <h1>Turn your study materials into high-retention Anki flashcards</h1>
        <p class="subtitle">
          Import PDFs, YouTube lectures, and web articles, generate atomic cards with your preferred AI model,
          audit card quality, and export directly to Anki.
        </p>
        <div class="cta-group">
          <a id="primary-dl" class="btn-primary" href={release.macos.url}>
            Download AnkiDraft v{release.version}
          </a>
          <a class="btn-secondary" href="/en/getting-started/quickstart/">
            Read the Quickstart Guide
          </a>
        </div>
        <div class="os-links">
          Direct installers:
          <a href={release.macos.url}>macOS (.dmg)</a> ·
          <a href={release.windows.url}>Windows (.exe)</a> ·
          <a href={release.linux.url}>Linux (.AppImage)</a>
        </div>
      </section>

      <section class="grid">
        <article class="card">
          <h2>1. Import any study source</h2>
          <p>
            Drop a textbook PDF (with LaTeX math), paste a YouTube link or a web article:
            AnkiDraft cleanly splits chapters and tracks which sections are already covered by flashcards.
          </p>
        </article>
        <article class="card">
          <h2>2. Generate and edit with precision</h2>
          <p>
            Connect OpenAI, Gemini, Claude, or run local models for free with Ollama. Edit cards with live KaTeX math preview,
            cloze deletions, and text-to-speech audio.
          </p>
        </article>
        <article class="card">
          <h2>3. Audit quality and sync with Anki</h2>
          <p>
            Built-in quality checks catch overloaded or vague flashcards based on Wozniak's 20 rules before exporting
            a ready-to-study <code>.apkg</code> deck for Anki Desktop and AnkiMobile.
          </p>
        </article>
      </section>

      <section id="download" class="downloads">
        <h2>Download AnkiDraft v{release.version}</h2>
        <div class="dl-grid">
          <div class="dl-box">
            <h3>macOS (Apple Silicon)</h3>
            <p>macOS 13+ · Signed disk image (<code>.dmg</code>)</p>
            <a href={release.macos.url}>Download for macOS →</a>
          </div>
          <div class="dl-box">
            <h3>Windows (64-bit)</h3>
            <p>Windows 10 / 11 · Standalone installer (<code>.exe</code>)</p>
            <a href={release.windows.url}>Download for Windows →</a>
          </div>
          <div class="dl-box">
            <h3>Linux (x86_64)</h3>
            <p>Portable single-file bundle (<code>.AppImage</code>)</p>
            <a href={release.linux.url}>Download for Linux →</a>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <span>&copy; 2026 AnkiDraft · Free, local-first desktop application</span>
      <span>
        <a href="/en/getting-started/installation/">Installation Guide</a> ·
        <a href="https://github.com/Skyl9/AnkiDraft">GitHub Repository</a> ·
        <a href="https://skyl9.github.io/AnkiDraft/">Developer Documentation</a>
      </span>
    </footer>

    <script is:inline define:vars={{ macosUrl: release.macos.url, windowsUrl: release.windows.url, linuxUrl: release.linux.url, version: release.version }}>
      (function () {
        var btn = document.getElementById('primary-dl');
        if (!btn) return;
        var ua = navigator.userAgent || '';
        if (/Win/i.test(ua)) {
          btn.href = windowsUrl;
          btn.textContent = 'Download for Windows (v' + version + ')';
        } else if (/Linux/i.test(ua) && !/Android/i.test(ua)) {
          btn.href = linuxUrl;
          btn.textContent = 'Download for Linux (v' + version + ')';
        } else if (/Mac/i.test(ua)) {
          btn.href = macosUrl;
          btn.textContent = 'Download for macOS (v' + version + ')';
        }
      })();
    </script>
  </body>
</html>
